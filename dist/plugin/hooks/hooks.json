{
  "$comment": "QADLC plugin hooks. Advisory except Stop, which enforces the plan-approval gate and checkbox discipline. Exec form (args present) means no shell. Every handler runs behind qadlc-preflight.sh, which execs straight through when bun is present (stdout and exit status pass untouched, so Stop's decision:block still lands) and, when bun is missing, reports once at SessionStart (--brief) while the per-turn hooks stay silent (--quiet).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/tools/qadlc-preflight.sh",
              "--brief",
              "bun",
              "${CLAUDE_PLUGIN_ROOT}/hooks/qadlc-session-start.ts"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/tools/qadlc-preflight.sh",
              "--quiet",
              "bun",
              "${CLAUDE_PLUGIN_ROOT}/hooks/qadlc-audit-logger.ts"
            ],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/tools/qadlc-preflight.sh",
              "--quiet",
              "bun",
              "${CLAUDE_PLUGIN_ROOT}/hooks/qadlc-sensor-fire.ts"
            ],
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/tools/qadlc-preflight.sh",
              "--quiet",
              "bun",
              "${CLAUDE_PLUGIN_ROOT}/hooks/qadlc-stop.ts"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/tools/qadlc-preflight.sh",
              "--quiet",
              "bun",
              "${CLAUDE_PLUGIN_ROOT}/hooks/qadlc-session-end.ts"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
